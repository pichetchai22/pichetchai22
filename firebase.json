{
  "hosting": {
    "public": "out", // เปลี่ยน public เป็น 'out' หรือ '.next/static' ถ้าคุณใช้ export static
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    // ลบส่วน rewrites เก่าออก และเพิ่ม apphosting source
    "apphosting": {
      "source": "."
    }
  }
}
